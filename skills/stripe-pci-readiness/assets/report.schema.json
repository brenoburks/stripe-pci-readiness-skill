{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brenoburks/stripe-pci-readiness-skill/blob/main/skills/stripe-pci-readiness/assets/report.schema.json",
  "title": "Stripe PCI readiness HTML report input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "report"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "report": { "$ref": "#/$defs/report" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "textArray": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "environment", "assessmentType"],
      "properties": {
        "repository": { "$ref": "#/$defs/text" },
        "commit": { "$ref": "#/$defs/text" },
        "environment": { "$ref": "#/$defs/text" },
        "assessmentType": { "$ref": "#/$defs/text" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessedSource", "deployedRuntime"],
      "properties": {
        "assessedSource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "branch", "worktreeState", "capturedAt", "evidence"],
          "properties": {
            "commit": { "$ref": "#/$defs/text" },
            "branch": { "$ref": "#/$defs/text" },
            "worktreeState": { "$ref": "#/$defs/text" },
            "capturedAt": { "$ref": "#/$defs/text" },
            "evidence": { "$ref": "#/$defs/text" }
          }
        },
        "deployedRuntime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "exactCommitStatus", "evidence"],
          "properties": {
            "status": { "$ref": "#/$defs/text" },
            "exactCommitStatus": { "$ref": "#/$defs/text" },
            "evidence": { "$ref": "#/$defs/text" }
          }
        }
      }
    },
    "scriptInventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["party", "owner", "purpose", "source", "changeControl", "paymentImpact", "evidence"],
      "properties": {
        "party": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" },
        "purpose": { "$ref": "#/$defs/text" },
        "source": { "$ref": "#/$defs/text" },
        "changeControl": { "$ref": "#/$defs/text" },
        "paymentImpact": { "$ref": "#/$defs/text" },
        "evidence": { "$ref": "#/$defs/text" }
      }
    },
    "serviceProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "role", "paymentSecurityImpact", "responsibility", "status", "evidence"],
      "properties": {
        "provider": { "$ref": "#/$defs/text" },
        "role": { "$ref": "#/$defs/text" },
        "paymentSecurityImpact": { "$ref": "#/$defs/text" },
        "responsibility": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/text" },
        "evidence": { "$ref": "#/$defs/text" }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integrationScope", "paymentPattern", "frameworkRuntime", "stripeSdk", "stripeApiVersion", "webhookApiVersion", "versionEvidence", "upgradeAssessment", "paymentPageScripts", "serviceProviders"],
      "properties": {
        "integrationScope": { "enum": ["web-ecommerce", "out-of-current-skill-scope"] },
        "paymentPattern": { "$ref": "#/$defs/text" },
        "frameworkRuntime": { "$ref": "#/$defs/text" },
        "stripeSdk": { "$ref": "#/$defs/text" },
        "stripeApiVersion": { "$ref": "#/$defs/text" },
        "webhookApiVersion": { "$ref": "#/$defs/text" },
        "versionEvidence": { "$ref": "#/$defs/text" },
        "upgradeAssessment": { "$ref": "#/$defs/text" },
        "paymentPageScripts": { "type": "array", "items": { "$ref": "#/$defs/scriptInventoryItem" } },
        "serviceProviders": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/serviceProvider" } }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "confidence", "rawCardDataExposure", "pciDependencies", "businessLaunchRules", "defenseInDepth", "keyUncertainty"],
      "properties": {
        "classification": { "$ref": "#/$defs/text" },
        "confidence": { "$ref": "#/$defs/text" },
        "rawCardDataExposure": { "$ref": "#/$defs/text" },
        "pciDependencies": { "$ref": "#/$defs/textArray" },
        "businessLaunchRules": { "$ref": "#/$defs/textArray" },
        "defenseInDepth": { "$ref": "#/$defs/textArray" },
        "keyUncertainty": { "$ref": "#/$defs/text" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded", "methodology"],
      "properties": {
        "included": { "$ref": "#/$defs/textArray" },
        "excluded": { "$ref": "#/$defs/textArray" },
        "methodology": { "$ref": "#/$defs/textArray" }
      }
    },
    "flowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "actor", "action", "evidence"],
      "properties": {
        "step": { "type": "integer", "minimum": 1 },
        "actor": { "$ref": "#/$defs/text" },
        "action": { "$ref": "#/$defs/text" },
        "evidence": { "$ref": "#/$defs/text" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "severity", "status", "category", "statementType", "observation", "consequence", "recommendation", "verification", "evidence", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "severity": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/text" },
        "category": { "$ref": "#/$defs/text" },
        "statementType": { "$ref": "#/$defs/text" },
        "observation": { "$ref": "#/$defs/text" },
        "consequence": { "$ref": "#/$defs/text" },
        "recommendation": { "$ref": "#/$defs/text" },
        "verification": { "$ref": "#/$defs/text" },
        "evidence": { "$ref": "#/$defs/textArray" },
        "sourceIds": { "$ref": "#/$defs/textArray" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "type", "status", "evidence", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "claim": { "$ref": "#/$defs/text" },
        "type": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/text" },
        "evidence": { "$ref": "#/$defs/text" },
        "sourceIds": { "$ref": "#/$defs/textArray" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "status", "evidence"],
      "properties": {
        "control": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/text" },
        "evidence": { "$ref": "#/$defs/text" }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technical", "operational"],
      "properties": {
        "technical": { "type": "array", "items": { "$ref": "#/$defs/control" } },
        "operational": { "type": "array", "items": { "$ref": "#/$defs/control" } }
      }
    },
    "remediationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "timing", "owner", "verification"],
      "properties": {
        "action": { "$ref": "#/$defs/text" },
        "timing": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" },
        "verification": { "$ref": "#/$defs/text" }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pciDependencies", "businessLaunchRules", "defenseInDepth"],
      "properties": {
        "pciDependencies": { "type": "array", "items": { "$ref": "#/$defs/remediationItem" } },
        "businessLaunchRules": { "type": "array", "items": { "$ref": "#/$defs/remediationItem" } },
        "defenseInDepth": { "type": "array", "items": { "$ref": "#/$defs/remediationItem" } }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "publisher", "url", "retrievedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "publisher": { "$ref": "#/$defs/text" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "retrievedAt": { "$ref": "#/$defs/text" }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subject", "generatedAt", "assessment", "provenance", "inventory", "outcome", "executiveSummary", "scope", "paymentFlow", "findings", "claimLedger", "controls", "remediation", "unknowns", "sources", "disclaimer"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "subject": { "$ref": "#/$defs/text" },
        "generatedAt": { "$ref": "#/$defs/text" },
        "assessment": { "$ref": "#/$defs/assessment" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "inventory": { "$ref": "#/$defs/inventory" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "executiveSummary": { "$ref": "#/$defs/textArray" },
        "scope": { "$ref": "#/$defs/scope" },
        "paymentFlow": { "type": "array", "items": { "$ref": "#/$defs/flowStep" } },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "claimLedger": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "controls": { "$ref": "#/$defs/controls" },
        "remediation": { "$ref": "#/$defs/remediation" },
        "unknowns": { "$ref": "#/$defs/textArray" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "disclaimer": { "const": "This is a technical PCI-readiness assessment, not certification or legal advice." }
      }
    }
  }
}
